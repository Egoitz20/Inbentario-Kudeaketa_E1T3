      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"pasahitza\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth.php?action=login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth.php"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "login"
                }
              ]
            },
            "description": "Guarda la cookie de sesión automáticamente (PHPSESSID)."
          },
          "response": []
        },
